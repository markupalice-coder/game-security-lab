{
  "schema_version": "1.0",
  "policy_name": "Player Data Classification",
  "default_rule": "When classification is unclear, choose the stricter class until the security owner approves a lower classification.",
  "classes": {
    "public": {
      "rank": 1,
      "description": "Approved data that may be displayed publicly after review.",
      "examples": [
        "approved leaderboard display name",
        "public tournament alias",
        "public patch note",
        "public server status message"
      ],
      "controls": {
        "collection_minimization": "required",
        "access_control": "basic repository or publishing workflow control",
        "encryption_in_transit": "required",
        "encryption_at_rest": "recommended",
        "retention_days": 365,
        "access_logging": "optional",
        "security_review": "recommended"
      }
    },
    "internal": {
      "rank": 2,
      "description": "Studio-only operational data that should not be exposed publicly.",
      "examples": [
        "aggregated telemetry",
        "build metrics",
        "service health",
        "anonymized crash counts",
        "regional latency aggregate"
      ],
      "controls": {
        "collection_minimization": "required",
        "access_control": "studio team limited",
        "encryption_in_transit": "required",
        "encryption_at_rest": "required",
        "retention_days": 365,
        "access_logging": "recommended",
        "security_review": "recommended"
      }
    },
    "confidential": {
      "rank": 3,
      "description": "Sensitive player or studio data that could cause harm if exposed.",
      "examples": [
        "account identifier",
        "support ticket",
        "moderation record",
        "fraud review note",
        "raw crash report with identifier",
        "player email address"
      ],
      "controls": {
        "collection_minimization": "required",
        "access_control": "need to know",
        "encryption_in_transit": "required",
        "encryption_at_rest": "required",
        "retention_days": 90,
        "access_logging": "required",
        "security_review": "required"
      }
    },
    "restricted": {
      "rank": 4,
      "description": "Vault-level data, secrets, credentials, or security-sensitive material.",
      "examples": [
        "payment-adjacent token",
        "anti-cheat secret",
        "signing key",
        "store upload credential",
        "production deployment credential",
        "raw authentication token",
        "private key"
      ],
      "controls": {
        "collection_minimization": "mandatory",
        "access_control": "explicit approval only",
        "encryption_in_transit": "required",
        "encryption_at_rest": "required",
        "retention_days": 30,
        "access_logging": "required",
        "security_review": "required"
      }
    }
  }
}
